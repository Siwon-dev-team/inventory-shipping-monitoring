SHOPIFY_API_KEY=832917927410ac7bd947fa7ffbef7a34
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://inventorymanagement.spfmktplace.tech.siwon.ca
SCOPES=read_products,read_inventory,read_locations,read_orders,write_inventory
NODE_ENV=production
DATABASE_URL=file:dev.sqlite

# Cron endpoint auth — must be at least 24 characters
CRON_SECRET=

# Email notifications via Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ALERT_EMAIL_TO=

# AI Assistant - Choose ONE (checked in order: Groq -> Gemini -> OpenAI)
# Without any key, falls back to smart rule-based answers.

# Option 1: Groq (FREE - Recommended) - Get key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Option 2: Google Gemini (FREE) - Get key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Option 3: OpenAI (Paid ~$0.001/question)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
